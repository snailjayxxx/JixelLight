#version 440
layout(local_size_x=16,local_size_y=16) in;
layout(std140,binding=0) uniform Plan {vec4 p[37];};
layout(rgba32f,binding=1) readonly uniform image2D baseImage;
layout(rgba32f,binding=2) readonly uniform image2D horizontalImage;
layout(rgba32f,binding=3) writeonly uniform image2D outputImage;
void main(){
 ivec2 c=ivec2(gl_GlobalInvocationID.xy),size=ivec2(p[24].xy);if(any(greaterThanEqual(c,size)))return;
 int a=clamp(int(p[32].z),1,12),b=clamp(int(p[32].w),1,12);precise float sa=0.0,sb=0.0;
 if(p[32].x>0.0)for(int i=-a;i<=a;++i)sa+=imageLoad(horizontalImage,ivec2(c.x,clamp(c.y+i,0,size.y-1))).r;
 if(p[32].y>0.0)for(int i=-b;i<=b;++i)sb+=imageLoad(horizontalImage,ivec2(c.x,clamp(c.y+i,0,size.y-1))).g;
 vec4 original=imageLoad(baseImage,c);precise float y=(.2126*original.r+.7152*original.g)+.0722*original.b;
 precise float delta=p[32].x*(y-sa/float(2*a+1))+p[32].y*(y-sb/float(2*b+1));
 vec3 rgb=floor(clamp(original.rgb+vec3(delta),vec3(0),vec3(1))*65535.0+vec3(.5))/65535.0;
 imageStore(outputImage,c,vec4(rgb,original.a));
}
