#version 440
layout(local_size_x=16, local_size_y=16, local_size_z=1) in;
layout(std140, binding=0) uniform Plan { vec4 p[25]; };
layout(rgba32f, binding=1) readonly uniform image2D sourceImage;
layout(rgba32f, binding=2) writeonly uniform image2D outputImage;
const float PI=3.14159265358979323846;
float smooth01(float x) { x=clamp(x,0.0,1.0); return x*x*(3.0-2.0*x); }
vec3 mulRows(int first,vec3 v) { return vec3(dot(p[first].xyz,v),dot(p[first+1].xyz,v),dot(p[first+2].xyz,v)); }
vec3 proToXyz(vec3 c) { return vec3(dot(vec3(.7976749,.1351917,.0313534),c),dot(vec3(.2880402,.7118741,.0000857),c),.8252100*c.z); }
vec3 proToSrgb(vec3 c) {
    vec3 d=proToXyz(c);
    vec3 x=vec3(dot(vec3(.9555766,-.0230393,.0631636),d),dot(vec3(-.0282895,1.0099416,.0210077),d),dot(vec3(.0122982,-.0204830,1.3299098),d));
    return vec3(dot(vec3(3.2404542,-1.5371385,-.4985314),x),dot(vec3(-.9692660,1.8760108,.0415560),x),dot(vec3(.0556434,-.2040259,1.0572252),x));
}
vec3 srgbToPro(vec3 c) {
    vec3 x=vec3(dot(vec3(.4124564,.3575761,.1804375),c),dot(vec3(.2126729,.7151522,.0721750),c),dot(vec3(.0193339,.1191920,.9503041),c));
    vec3 d=vec3(dot(vec3(1.0478112,.0228866,-.0501270),x),dot(vec3(.0295424,.9904844,-.0170491),x),dot(vec3(-.0092345,.0150436,.7521316),x));
    return vec3(dot(vec3(1.3459433,-.2556075,-.0511118),d),dot(vec3(-.5445989,1.5081673,.0205351),d),1.2118128*d.z);
}
float decode(float v) { v=max(v,0.0); return v<=.04045 ? v/12.92 : pow((v+.055)/1.055,2.4); }
float encode(float v) {
    v=clamp(v,0.0,1.0);
    if(p[9].w==2.0) return pow(v,1.0/2.2);
    if(p[9].w==3.0) return pow(v,1.0/1.8);
    return v<=.0031308 ? 12.92*v : 1.055*pow(v,1.0/2.4)-.055;
}
vec3 toLab(vec3 c) {
    vec3 a=vec3(dot(vec3(.4122214708,.5363325363,.0514459929),c),dot(vec3(.2119034982,.6806995451,.1073969566),c),dot(vec3(.0883024619,.2817188376,.6299787005),c));
    a=sign(a)*pow(abs(a),vec3(1.0/3.0));
    return vec3(dot(vec3(.2104542553,.7936177850,-.0040720468),a),dot(vec3(1.9779984951,-2.4285922050,.4505937099),a),dot(vec3(.0259040371,.7827717662,-.8086757660),a));
}
vec3 fromLab(vec3 c) {
    vec3 a=vec3(c.x+.3963377774*c.y+.2158037573*c.z,c.x-.1055613458*c.y-.0638541728*c.z,c.x-.0894841775*c.y-1.2914855480*c.z);
    a=a*a*a;
    return vec3(dot(vec3(4.0767416621,-3.3077115913,.2309699292),a),dot(vec3(-1.2684380046,2.6097574011,-.3413193965),a),dot(vec3(-.0041960863,-.7034186147,1.7076147010),a));
}
float wrapHue(float h) { return h-floor(h/360.0)*360.0; }
vec3 colorAdjust(vec3 c) {
    vec3 lab=toLab(c);
    float chroma=length(lab.yz);
    float hue=chroma>1e-6 ? wrapHue(atan(lab.z,lab.y)*180.0/PI) : 0.0;
    hue=wrapHue(hue+p[5].x);
    float scale=max(0.0,1.0+p[4].z)*max(0.0,1.0+p[4].w*(1.0-clamp(chroma/.30,0.0,1.0))*.85);
    vec3 delta=vec3(0.0);
    for(int i=0;i<8;++i) {
        vec4 band=p[11+i];
        if(any(notEqual(band.xyz,vec3(0.0)))) {
            float d=abs(hue-band.w); d=min(d,360.0-d);
            if(d<52.0) delta+=band.xyz*(.5+.5*cos(PI*d/52.0));
        }
    }
    hue=wrapHue(hue+delta.x);
    chroma*=scale*max(0.0,1.0+delta.y);
    lab.x=clamp(lab.x+delta.z,0.0,1.5);
    lab.yz=chroma*vec2(cos(hue*PI/180.0),sin(hue*PI/180.0));
    return fromLab(lab);
}
float shoulder(float value,float recovery) {
    value=max(value,0.0);
    float start=.82-.18*recovery;
    if(value<=start) return value;
    float span=max(.01,1.0-start);
    return start+span*(1.0-exp(-(1.65+1.85*recovery)*(value-start)/span));
}
float curve(float x,int channel) {
    float position=clamp(x,0.0,1.0)*4.0;
    int segment=min(int(position),3);
    return clamp(mix(p[19+segment][channel],p[20+segment][channel],position-float(segment)),0.0,1.0);
}
void main() {
    ivec2 coord=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(coord,ivec2(p[24].xy)))) return;
    vec4 original=imageLoad(sourceImage,coord);
    vec3 v=original.rgb;
    if(p[5].y==0.0) v=srgbToPro(vec3(decode(v.r),decode(v.g),decode(v.b)));
    v=mulRows(0,v);
    float recovery=p[4].y;
    float highest=max(v.r,max(v.g,v.b));
    if(recovery>0.0 && highest>.82) {
        float weight=smooth01((highest-.82)/1.25)*recovery;
        float target=.82+.62*(1.0-exp(-(highest-.82)/.62));
        v*=1.0+(target/highest-1.0)*weight;
    }
    if(p[5].w!=0.0) {
        float y=max(0.0,proToXyz(v).y);
        float stops=p[3].y*(1.0-smooth01(y/.32))+p[3].x*smooth01((y-.26)/.82)+p[3].z*smooth01((y-.62)/.70)*.75+p[3].w*(1.0-smooth01(y/.16))*.75;
        v*=exp2(stops);
    }
    if(p[10].x==0.0) { float y=max(0.0,proToXyz(v).y); if(y>1e-6) v*=.18*pow(y/.18,p[4].x)/y; }
    v=proToSrgb(v);
    if(p[5].z!=0.0) v=colorAdjust(v);
    else if(max(v.r,max(v.g,v.b))>3.3 || min(v.r,min(v.g,v.b))<0.0) { vec3 lab=toLab(v); lab.x=clamp(lab.x,0.0,1.5); v=fromLab(lab); }
    v=mulRows(6,v);
    float y=max(0.0,dot(p[9].xyz,v)),smallest=min(v.r,min(v.g,v.b));
    // Match CPU: continuous inset near zero prevents a visible jump when
    // backend floating-point roundoff straddles the gamut boundary.
    if(smallest<0.0 && y>1e-6) {
        float inset=1.0-.005*smooth01(-smallest/.001);
        v=vec3(y)+(v-vec3(y))*(clamp(y/(y-smallest),0.0,1.0)*inset);
    }
    v=max(v,vec3(0.0));
    v=vec3(shoulder(v.r,recovery),shoulder(v.g,recovery),shoulder(v.b,recovery));
    if(p[10].y==0.0) { y=max(0.0,dot(p[9].xyz,v)); if(y>1e-6) v*=curve(y,0)/y; }
    if(p[10].z==0.0) v=vec3(curve(v.r,1),curve(v.g,2),curve(v.b,3));
    v=vec3(encode(v.r),encode(v.g),encode(v.b));
    // Match the CPU display boundary; the working calculations above are FP32.
    v=floor(clamp(v,vec3(0.0),vec3(1.0))*65535.0+vec3(.5))/65535.0;
    imageStore(outputImage,coord,vec4(v,original.a));
}
